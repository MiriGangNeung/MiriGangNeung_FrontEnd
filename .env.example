# Kakao Maps JavaScript SDK key (safe for browser use with registered domains)
VITE_KAKAO_MAP_API_KEY=your_kakao_javascript_key

# Kakao REST API key (server only; never prefix this with VITE_)
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# Existing application API base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1
